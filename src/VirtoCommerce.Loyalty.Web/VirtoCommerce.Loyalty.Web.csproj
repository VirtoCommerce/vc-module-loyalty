<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Project is not a test project -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Content Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
    <None Remove="dist\**" />
    <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <AdminShellPlugin Include="plugins\**" />
  </ItemGroup>
  <Target Name="CopyAdminShellPluginOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.Loyalty.Core\VirtoCommerce.Loyalty.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.Loyalty.Data\VirtoCommerce.Loyalty.Data.csproj" />
    <ProjectReference Include="..\VirtoCommerce.Loyalty.Data.MySql\VirtoCommerce.Loyalty.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.Loyalty.Data.PostgreSql\VirtoCommerce.Loyalty.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.Loyalty.Data.SqlServer\VirtoCommerce.Loyalty.Data.SqlServer.csproj" />
    <ProjectReference Include="..\VirtoCommerce.Loyalty.ExperienceApi\VirtoCommerce.Loyalty.ExperienceApi.csproj" />
  </ItemGroup>
</Project>
