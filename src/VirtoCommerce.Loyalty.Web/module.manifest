<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.Loyalty</id>
  <version>3.1000.2</version>
  <version-tag></version-tag>

  <platformVersion>3.1007.17</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.Core" version="3.1000.0" />
    <dependency id="VirtoCommerce.Orders" version="3.1000.4" />
    <dependency id="VirtoCommerce.Catalog" version="3.1000.0" />
    <dependency id="VirtoCommerce.Xapi" version="3.1003.1" />
    <dependency id="VirtoCommerce.XCart" version="3.1000.5" />
    <dependency id="VirtoCommerce.XCatalog" version="3.1000.0" />
